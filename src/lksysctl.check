#!/bin/sh
rm -rf "${ctmp}"
trap 'rm -rf "${ctmp}"' EXIT

lksysctl
echo $?
lksysctl -V
echo $?

mkdir "${ctmp}"
cat >"${ctmp}"/run <<-\EOT
	#!/bin/sh
	echo starting
	exec sleep 14
	EOT
chmod 700 "${ctmp}"/run
lksys "${ctmp}" &
sleep 1
test -r "${ctmp}"/supervise/stat || sleep 2
lksysctl down "${ctmp}"
echo $?
sleep 1
cat "${ctmp}"/supervise/stat
lksysctl exit "${ctmp}"
echo $?
wait
echo $?
