#!/bin/sh
# Dbus system bus daemon for lksystem
rm -f /run/dbus/pid
mkdir -p /run/dbus /run/lksystem/started
touch /run/lksystem/started/dbus
# Ensure D-Bus has its machine ID generated (required by many activated services)
dbus-uuidgen --ensure
# FIX: Added --nopidfile. The redirection silences dbus-daemon itself perfectly.
exec dbus-daemon --system --nofork --nopidfile >/dev/null 2>&1
