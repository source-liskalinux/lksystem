#!/bin/sh
# Login and session service for lksystem
# Ensure the dbus system bus daemon is up before starting elogind
wait_for_socket() {
  timeout=30
  while ! test -S "$1" && ! test -S "$2"; do
    timeout=$((timeout - 1))
    if test "$timeout" -eq 0; then
      echo "Timeout waiting for D-Bus socket" >&2
      exit 1
    fi
    sleep 1
  done
}

wait_for_socket /run/dbus/system_bus_socket /var/run/dbus/system_bus_socket

# Execute elogind in the foreground so lksysdir can track it
exec /usr/lib/elogind/elogind --daemon=false
